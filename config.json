{
  "_comment": "Settings for the EUC Studio pipeline. Paths are relative to this folder unless absolute. Edit freely; scripts re-read this every run.",

  "paths": {
    "inbox": "inbox",
    "stitched": "stitched",
    "work": "work",
    "music": "music",
    "output": "output"
  },

  "ingest": {
    "ride_gap_minutes": 45,
    "gopro_extensions": [".mp4", ".360"],
    "insta_extensions": [".insv"],
    "stitched_extensions": [".mp4", ".mov"]
  },

  "audio": {
    "sample_rate": 48000,
    "voice_highpass_hz": 80,
    "voice_noise_floor_db": -25,
    "ambient_gain_db": -22,
    "ambient_speed_boost_db": 8,
    "music_gain_db": -16,
    "target_lufs": -14,
    "target_true_peak": -1
  },

  "sync": {
    "envelope_hz": 100,
    "search_window_s": 120,
    "min_confidence": 4.0
  },

  "transcribe": {
    "model": "large-v3",
    "device": "cuda",
    "compute_type": "int8_float16",
    "language": "en",
    "highlight_cues": [
      "clip that", "mark it", "watch this", "oh shit", "holy shit", "did you see that"
    ],
    "excitement_words": [
      "whoa", "woah", "wow", "woo", "woohoo", "let's go", "oh my god", "oh my gosh", "holy crap", "sick"
    ]
  },

  "telemetry": {
    "speed_units": "mph",
    "peak_window_s": 15,
    "sustained_percentile": 80,
    "sustained_min_s": 10,
    "moving_wind": 50,
    "moving_bump": 1.5,
    "motion_peak_percentile": 90,
    "motion_max_peaks": 8
  },

  "frames": {
    "interval_s": 7,
    "thumb_width": 320,
    "sheet_columns": 6,
    "sheet_rows": 5,
    "insta_views": {
      "forward":      {"yaw": 0,   "pitch": 0,   "fov": 100},
      "rear":         {"yaw": 180, "pitch": 0,   "fov": 100},
      "third_person": {"yaw": 180, "pitch": -25, "fov": 115},
      "left":         {"yaw": -90, "pitch": 0,   "fov": 100},
      "right":        {"yaw": 90,  "pitch": 0,   "fov": 100}
    }
  },

  "edit": {
    "long_min_s": 300,
    "long_max_s": 900,
    "max_shot_s": 8,
    "silence_cut_s": 2.0,
    "speech_pad_s": 0.5,
    "short_count": 3,
    "short_max_s": 58,
    "short_pre_s": 8,
    "short_post_s": 20,
    "insta_default_view": "forward",
    "insta_alt_view": "third_person"
  },

  "render": {
    "long_width": 1920,
    "long_height": 1080,
    "short_width": 1080,
    "short_height": 1920,
    "video_codec": "hevc_nvenc",
    "nvenc_preset": "p5",
    "nvenc_cq": 23,
    "audio_bitrate": "192k",
    "use_cuda_decode": true
  },

  "music": {
    "_comment": "Direction comes from docs/music_brief.md (Tyler's EUC '26 playlist). Each style below is one row of the brief's table.",
    "sample_rate": 48000,
    "styles": {
      "dnb":     {"bpm": 174, "use": "Drum & bass: rolling breaks, reese bass, rave stabs. High-speed runs, downhill, overtakes."},
      "electro": {"bpm": 128, "use": "Electro house: four-on-the-floor, wobble bass, distorted saw stabs, sirens. Hard-hitting moments (highlight cues)."},
      "funk":    {"bpm": 110, "use": "Funk-hop / electro-swing: swung breakbeat, slap bass, brass stabs, 'hey!' shouts, scratches. Cruising and talking."},
      "indie":   {"bpm": 118, "use": "Sunny indie electronic: soft four-on-the-floor, warm pads, arpeggios. Scenery and golden hour."},
      "blues":   {"bpm": 92,  "use": "Gritty blues riff over a foot-stomp beat. Accent only: intro sting / tension, never a whole track."},
      "liquid":  {"bpm": 174, "use": "Liquid drum & bass: rolling but uplifting, pads, wordless vocals. Outro."}
    },
    "style_for": {
      "speed": "dnb",
      "cue": "electro",
      "motion": "dnb",
      "commentary": "funk",
      "scenery": "indie"
    },
    "long_intro_style": "blues",
    "long_intro_max_s": 15,
    "long_outro_style": "liquid",
    "long_outro_s": 30,
    "min_section_s": 20,
    "max_track_s": 180,
    "voice_pocket_db": -4,
    "write_stems": "long"
  }
}
